<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LWhisper.UI.WPF</RootNamespace>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <!-- Локально всегда 0.0.0 (dev-сборка, авто-проверка обновлений отключается);
         реальная версия приходит из git-тега через CI: -p:Version=X.Y.Z -->
    <Version>0.0.0</Version>
    <!-- Собственный Main: updater-режим (apply-update) должен отработать ДО конструирования
         WPF Application: базовый ctor уже дергает loose-нативки WPF, которых нет у копии exe -->
    <StartupObject>LWhisper.UI.WPF.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Пост-фильтры SegmentRecognitionManager (IsKnownHallucination) покрыты прямыми тестами -->
    <InternalsVisibleTo Include="LWhisper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LWhisper.Core\LWhisper.Core.csproj" />
    <ProjectReference Include="..\LWhisper.SpeechEngine\LWhisper.SpeechEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- D7: нативные рантаймы Whisper живут в дистрибутиве (UI.WPF), не в движке-библиотеке -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.2" />
    <PackageReference Include="WebRtcVadSharp" Version="1.3.2" />
  </ItemGroup>

</Project>
